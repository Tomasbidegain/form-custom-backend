      "_postman_id": "folder-forms",
      "name": "Forms",
      "description": "Form management endpoints: CRUD for forms and fields. All endpoints require authentication.",
      "item": [
        {
          "_postman_id": "form-create",
          "name": "Create Form",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My Form\",\n  \"description\": \"A test form\",\n  \"oneResponsePerEmail\": false,\n  \"captchaEnabled\": true,\n  \"fields\": [\n    {\n      \"label\": \"Full Name\",\n      \"type\": \"TEXT\",\n      \"required\": true,\n      \"gridX\": 0,\n      \"gridY\": 0,\n      \"gridW\": 12,\n      \"gridH\": 1\n    },\n    {\n      \"label\": \"Email\",\n      \"type\": \"EMAIL\",\n      \"required\": true,\n      \"gridX\": 0,\n      \"gridY\": 1,\n      \"gridW\": 6,\n      \"gridH\": 1\n    },\n    {\n      \"label\": \"Favorite Color\",\n      \"type\": \"SELECT\",\n      \"required\": false,\n      \"options\": [\"Red\", \"Blue\", \"Green\"],\n      \"gridX\": 6,\n      \"gridY\": 1,\n      \"gridW\": 6,\n      \"gridH\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/forms",
              "host": ["{{base_url}}"],
              "path": ["forms"]
            },
            "description": "Create a new form with fields. Requires authentication."
          },
          "response": []
        },
        {
          "_postman_id": "form-list",
          "name": "List Forms",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/forms?page=1&limit=10&search=&sortBy=createdAt&sortOrder=desc",
              "host": ["{{base_url}}"],
              "path": ["forms"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "" },
                { "key": "sortBy", "value": "createdAt" },
                { "key": "sortOrder", "value": "desc" }
              ]
            },
            "description": "List all forms of the authenticated user with pagination, search, and sorting."
